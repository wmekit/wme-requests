/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wme-requests",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/server-entry.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"triggers": {
		// Daily at 03:00 UTC — clears requests' links to screenshots older than a week, which the
		// bucket's R2 lifecycle rule deletes (see the `scheduled` handler in src/server-entry.ts).
		"crons": ["0 3 * * *"]
	},
	"vars": {
		// Origins allowed to call the API cross-origin (comma-separated, or * for all).
		// Restricted to Waze's own domains since the userscript is the only cross-origin
		// caller of the public POST /api/requests endpoint — everything else (the dashboard)
		// is same-origin and unaffected by this. Includes both waze.com and www.waze.com
		// since Waze's own generated links use the bare domain while the app may serve under www.
		// requests.wazetools.com is the pre-move host: still attached (custom domains are set in the
		// dashboard) and still serving /api, so it stays allowed.
		"ALLOWED_ORIGINS": "https://waze.com,https://www.waze.com,https://beta.waze.com,https://requests.wmekit.com,https://requests.wazetools.com",
		// "true" to make POST /api/requests and /api/screenshots refuse userscript-manager requests
		// that don't name a Waze page in X-WME-Requests-Origin (see requireWazeOrigin in
		// src/lib/http.ts). The userscript sends it from v2.9.0; turn this on once older installs
		// have updated, since they'd be refused. Requests from other websites are refused either way.
		"REQUIRE_PAGE_ORIGIN_HEADER": "false",
		// This app's own origin, for absolute ?redirect= URLs back from the account service and
		// the link in "set your password" emails sent when an admin adds someone.
		"APP_URL": "https://requests.wmekit.com",
		// The WMEKit account service (wmeAuth) where people sign in. Its session cookie covers
		// .wmekit.com; sessions are checked over the AUTH service binding below.
		"AUTH_URL": "https://auth.wmekit.com",
		// Web Push VAPID public key — safe to expose (it's sent to the browser as
		// applicationServerKey). The matching private key is WEB_PUSH_VAPID_PRIVATE_JWK,
		// a secret — see DEPLOYMENT.md. Placeholder; replace with your own generated pair.
		"WEB_PUSH_VAPID_PUBLIC_KEY": "BI7TZK5g2JTEXxFtmOy3KiCWs1rLvNAzsCNOWK_l3mb_jiyZrAKAyZOsYNuu0zIFJQxUXYoHIlTxz8R7v6ZrfR4",
		// Contact address required by the Web Push protocol (VAPID "sub" claim) so push
		// services can reach you about problems with your usage.
		"WEB_PUSH_CONTACT": "mailto:wazerequest@michaelrosstarr.com ",
		// The Discord application (= OAuth2 client ID) of this app's own bot, used by the
		// "Discord (Bot)" channel platform. Its DISCORD_BOT_TOKEN and DISCORD_CLIENT_SECRET are
		// secrets — see DEPLOYMENT.md. Empty disables adding the bot to servers.
		"DISCORD_APPLICATION_ID": "1555362691571253248",
		// The same application's Public Key (Developer Portal → General Information), used to
		// verify button clicks sent to /api/discord/interactions. Empty leaves the buttons off
		// threaded Discord (Bot) channels' messages.
		"DISCORD_PUBLIC_KEY": "6e97e2c7df2aa0c2b4835a48f0e6c9a3b163941838da938d96b1cfc9e610a43a"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wme-requests",
			// Replace with the ID printed by: wrangler d1 create wme-requests
			"database_id": "2af446ca-93ff-4681-ab5c-80edcd5098d0",
			"remote": true
		}
	],
	// The WMEKit account service (Worker "wmeauth"). Sessions are validated with
	// AUTH.fetch(".../api/auth/get-session"), and it has RPC methods for looking up and inviting
	// users (see src/lib/central-auth.ts). Worker-to-worker, so no public hop and no shared secret.
	"services": [
		{
			"binding": "AUTH",
			"service": "wmeauth"
		}
	],
	"r2_buckets": [
		{
			"binding": "SCREENSHOTS",
			// Replace with the name you passed to: wrangler r2 bucket create <name>
			// Objects expire after 7 days via a lifecycle rule on the bucket (see DEPLOYMENT.md).
			"bucket_name": "wme-requests-screenshots"
		}
	]
}
